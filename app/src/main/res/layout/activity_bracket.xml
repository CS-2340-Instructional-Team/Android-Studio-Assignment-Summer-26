<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BracketActivity"
    android:padding="16dp">

    <!-- Standings display at the top -->
    <TextView
        android:id="@+id/tvStandings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pizza: 0 | Sushi: 0 | Tacos: 0 | Burger: 0 | Ramen: 0"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Current matchup prompt -->
    <TextView
        android:id="@+id/tvMatchup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Food A vs. Food B — which do you prefer?"
        android:textSize="20sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvStandings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Two-option radio group -->
    <RadioGroup
        android:id="@+id/rgChoices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvMatchup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/rbFoodA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food A" />

        <RadioButton
            android:id="@+id/rbFoodB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food B" />

    </RadioGroup>

    <!-- Feedback message -->
    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/feedback_default"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/rgChoices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Vote button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vote"
        app:layout_constraintTop_toBottomOf="@id/tvFeedback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Next matchup button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/next"
        app:layout_constraintTop_toBottomOf="@id/btnVote"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TODO 7:
         Add a Reset button below btnNext.
         Look at how btnNext is defined above and follow the same pattern.
         The id should be btnReset and the text string key is "reset".
    -->

</androidx.constraintlayout.widget.ConstraintLayout>